{
  "name": "taskflow",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "test": "npm --prefix backend run build && node --test scripts/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "ios": "npm run build && npx cap sync ios && xattr -cr ios/App/App && npx cap open ios",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@radix-ui/react-dialog": "1.1.6",
    "clsx": "2.1.1",
    "i18next": "^26.3.0",
    "lucide-react": "0.487.0",
    "motion": "^12.40.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^17.0.8",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}
