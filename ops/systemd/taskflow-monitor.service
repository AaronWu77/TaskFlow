[Unit]
Description=Check TaskFlow health, backups, disk, and TLS
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/taskflow/ops.env
ExecStart=/opt/TaskFlow/ops/monitor/check-taskflow.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/TaskFlow /opt/taskflow-backups
