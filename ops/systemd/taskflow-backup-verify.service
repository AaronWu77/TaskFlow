[Unit]
Description=Verify the latest TaskFlow PostgreSQL backup archive
After=taskflow-backup.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/taskflow/ops.env
ExecStart=/opt/TaskFlow/ops/backup/verify-latest-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/TaskFlow /opt/taskflow-backups
