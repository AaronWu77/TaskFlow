# Install as /etc/taskflow/ops.env with owner root:root and mode 0600.
# Do not commit the real file.

TASKFLOW_COMPOSE_DIR=/opt/TaskFlow
# Optional override used when the Compose file has a non-default name.
# TASKFLOW_COMPOSE_FILE=/opt/TaskFlow/docker-compose.yml
TASKFLOW_BACKUP_DIR=/opt/taskflow-backups
TASKFLOW_POSTGRES_SERVICE=postgres
TASKFLOW_DB_NAME=taskflow
TASKFLOW_DB_USER=taskflow
TASKFLOW_BACKUP_RETENTION_LOCAL_COUNT=3
TASKFLOW_BACKUP_MAX_AGE_HOURS=30
TASKFLOW_LOCK_FILE=/run/lock/taskflow-backup.lock
TASKFLOW_RESTORE_DRILL_PROJECT=taskflow-restore-drill
TASKFLOW_RESTORE_DRILL_LOCK_FILE=/run/lock/taskflow-restore-drill.lock
TASKFLOW_RESTORE_REPORT_DIR=/opt/taskflow-restore-reports
TASKFLOW_RESTORE_REPORT_MAX_AGE_HOURS=840
# Optional immutable API image used by restore drills. When empty, the script
# reuses the currently running production API image before considering a build.
TASKFLOW_RESTORE_API_IMAGE=

# Private OSS bucket and optional prefix, without a trailing slash.
# Leave empty to create and verify local backups without uploading.
TASKFLOW_OSS_URI=oss://replace-with-private-bucket/taskflow/production

# ossutil v2 configuration. Prefer an ECS RAM role where available.
TASKFLOW_OSSUTIL_CONFIG=/etc/taskflow/ossutilconfig

# Per-object encryption. AES256 uses SSE-OSS; KMS additionally requires a key ID.
TASKFLOW_OSS_SSE_ALGORITHM=AES256
TASKFLOW_OSS_KMS_KEY_ID=

# Monitoring thresholds.
TASKFLOW_HEALTH_URL=https://taskflow.top/api/v1/health
TASKFLOW_TLS_HOST=taskflow.top
TASKFLOW_DISK_PATH=/var/lib/docker
TASKFLOW_DISK_WARN_PERCENT=70
TASKFLOW_DISK_CRITICAL_PERCENT=85
TASKFLOW_TLS_WARN_DAYS=30
TASKFLOW_LONG_TRANSACTION_SECONDS=300
TASKFLOW_DB_SIZE_WARN_MB=1024

# Optional generic JSON webhook. Leave empty to rely on the systemd failure state.
TASKFLOW_ALERT_WEBHOOK_URL=
TASKFLOW_METRICS_URL=https://taskflow.top/api/v1/ops/metrics
TASKFLOW_OPS_METRICS_TOKEN=replace-with-a-long-random-token
TASKFLOW_5XX_CRITICAL_PERCENT=5
TASKFLOW_P95_WARN_MS=2000
TASKFLOW_SYNC_CONFLICT_WARN_PERCENT=20
TASKFLOW_SYNC_REJECTION_CRITICAL_PERCENT=5
