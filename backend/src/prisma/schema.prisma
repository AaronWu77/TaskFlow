// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  emailVerifiedAt DateTime?
  displayName String?
  timezone String?
  locale String?
  deletedAt DateTime?
  deleteScheduledFor DateTime?
  passwordChangedAt DateTime @default(now())
  authVersion Int @default(1)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  stats     UserStats?
  dailyStats UserDailyStats[]
  syncState UserSyncState?
  devices   Device[]
  taskChanges TaskChange[]
  refreshSessions RefreshSession[]
  taskOperations TaskOperation[]
  taskSeries TaskSeries[]
}

model Task {
  id              String   @id @default(cuid())
  userId          String
  title           String
  priority        String   // P1 | P2 | P3
  estimateMinutes Int?
  status          String   // todo | done | skipped
  tag             String?
  progress        Int      @default(0)
  dueDate         String?  // YYYY-MM-DD
  dueDateTyped    DateTime? @db.Date
  reminderAt      String?  // ISO datetime
  reminderAtTyped DateTime? @db.Timestamptz(3)
  repeatRule      String?  // none | daily | weekly | monthly
  repeatUntilDate String?  // YYYY-MM-DD
  repeatUntilDateTyped DateTime? @db.Date
  seriesId        String?
  seriesVersion   Int?
  occurrenceDate  String?  // YYYY-MM-DD; stable identity within a recurrence series
  occurrenceDateTyped DateTime? @db.Date
  completedAt     String?  // ISO datetime set by server when completed
  completedAtTyped DateTime? @db.Timestamptz(3)
  deletedAt       String?  // ISO datetime for soft delete / undo
  deletedAtTyped  DateTime? @db.Timestamptz(3)
  scheduleExcludedAt DateTime? @db.Timestamptz(3)
  sortOrder       Int      @default(0)
  version         Int      @default(1)
  lastChangedByDeviceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, dueDateTyped])
  @@index([userId, completedAt])
  @@index([userId, completedAtTyped])
  @@index([userId, deletedAt])
  @@index([userId, deletedAtTyped])
  @@index([userId, sortOrder])
  @@index([userId, version])
  @@index([userId, seriesId])
  @@index([userId, seriesId, scheduleExcludedAt])
  @@unique([userId, seriesId, occurrenceDate])
}

model TaskSeries {
  id              String   @id @default(cuid())
  userId          String
  title           String
  priority        String
  estimateMinutes Int?
  tag             String?
  repeatRule      String
  startDate       DateTime @db.Date
  untilDate       DateTime @db.Date
  timezone        String
  reminderAt      DateTime? @db.Timestamptz(3)
  generatedThrough DateTime? @db.Date
  version         Int      @default(1)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([userId, generatedThrough])
}

model Device {
  id         String   @id
  userId     String
  name       String?
  platform   String?
  lastSeenAt DateTime @default(now())
  lastAcknowledgedCursor Int @default(0)
  requiresBootstrap Boolean @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastSeenAt])
  @@index([userId, lastAcknowledgedCursor])
}

model UserSyncState {
  id               String @id @default(cuid())
  userId           String @unique
  nextSeq          Int    @default(1)
  taskOrderVersion Int    @default(1)
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TaskChange {
  id          String   @id @default(cuid())
  userId      String
  seq         Int
  taskId      String?
  operationId String?
  deviceId    String?
  type        String
  snapshot    Json?
  tombstone   Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seq])
  @@unique([userId, operationId])
  @@index([userId])
  @@index([taskId])
  @@index([createdAt])
}

model TaskOperation {
  id          String   @id @default(cuid())
  operationId String
  userId      String
  taskId      String?
  type        String
  response    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, operationId])
  @@index([taskId])
  @@index([createdAt])
}

model UserStats {
  id             String  @id @default(cuid())
  userId         String  @unique
  streak         Int     @default(0)
  streakDate     String? // YYYY-MM-DD
  completedToday String? // YYYY-MM-DD
  todayCount     Int     @default(0)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserDailyStats {
  id        String   @id @default(cuid())
  userId    String
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  reuseGraceUntil DateTime?
  familyId  String
  deviceName String?
  platform String?
  lastSeenAt DateTime @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, familyId])
  @@index([userId, lastSeenAt])
  @@index([reuseGraceUntil])
}

model PasswordReset {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model AccountDeletionAudit {
  id          String   @id @default(cuid())
  userId      String
  emailHash   String
  action      String
  scheduledFor DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model EmailVerification {
  email     String   @id
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
